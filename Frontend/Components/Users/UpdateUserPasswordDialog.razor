@using Application.Users
@inject UserService UserService

<div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-xl">
        <div class="mb-4 flex items-center justify-between">
            <h2 class="text-xl font-semibold">Update Password</h2>
            <button type="button" class="text-2xl leading-none text-gray-500 hover:text-gray-800" @onclick="OnCancel">&times;</button>
        </div>
        <div class="mb-3">
            <label for="old-password" class="mb-1 block text-sm font-medium">Old Password</label>
            <input type="password" id="old-password" class="@InputClass" @bind="oldPassword" />
        </div>
        <div class="mb-4">
            <label for="new-password" class="mb-1 block text-sm font-medium">New Password</label>
            <input type="password" id="new-password" class="@InputClass" @bind="newPassword" />
        </div>
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="mb-4 text-red-600">@errorMessage</div>
        }
        <div class="flex justify-end gap-2">
            <button class="rounded bg-gray-200 px-4 py-2 hover:bg-gray-300" @onclick="OnCancel">Cancel</button>
            <button class="rounded bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" @onclick="SubmitAsync">Save</button>
        </div>
    </div>
</div>

@code {
    private const string InputClass =
        "w-full rounded border border-gray-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200";

    [Parameter, EditorRequired] public ShowUsersResponse User { get; set; } = default!;
    [Parameter] public EventCallback OnUpdated { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string errorMessage = string.Empty;
    private string oldPassword = string.Empty;
    private string newPassword = string.Empty;

    private async Task SubmitAsync()
    {
        try
        {
            await UserService.ChangePasswordAsync(new ChangePasswordRequest(User.Id, oldPassword, newPassword));
            await OnUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            // Handle the exception (e.g., show an error message)
            errorMessage = ex.Message;
        }
    }
}