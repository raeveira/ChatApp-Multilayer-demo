@page "/"
@rendermode InteractiveServer
@using Application
@inject GreetingService GreetingService

<PageTitle>Home</PageTitle>

<a href="/user-management" class="text-indigo-600 hover:underline">Go to User Management</a>
<h1 class="text-3xl font-bold text-indigo-600">@greeting</h1>

<input class="mt-4 mb-2 block w-full max-w-xs rounded border border-gray-300 px-3 py-2 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" placeholder="Your name" @bind="name" />
<button class="rounded bg-indigo-600 px-4 py-2 text-white hover:bg-indigo-700" @onclick="LoadAsync">Greet</button>

@code {
    private string? name;
    private string greeting = "Loading...";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync() =>
        greeting = await GreetingService.GetGreetingAsync(name);
}
